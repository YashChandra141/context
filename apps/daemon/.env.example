# Direct Neon connection string (hostname without -pooler).
DATABASE_URL=postgres://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

MACHINE_NAME=pc
PORT=8787

# Optional. Defaults to the Tailscale IPv4 address, or 127.0.0.1 when Tailscale is absent.
# BIND_HOST=100.x.x.x
# PUBLIC_URL=http://100.x.x.x:8787

# Semicolon-separated absolute paths. Overrides daemon.config.json.
# ALLOWED_ROOTS=D:\project

# Dev only. Skips Neon and keeps sessions in memory.
# PHONE_STORE=memory
