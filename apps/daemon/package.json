{
  "name": "@phone/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "smoke": "bun src/scripts/smoke-acp.ts",
    "neon:branches": "bun src/scripts/neon-branches.ts",
    "db:generate": "drizzle-kit generate --name init",
    "db:migrate": "bun src/scripts/apply-migrations.ts",
    "build:exe": "bun build --compile --target=bun-windows-x64 --outfile dist/daemon src/index.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.27.0",
    "@phone/protocol": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.4"
  }
}
